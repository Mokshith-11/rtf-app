{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rtf-app",
  "main": "worker.ts",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./RTF-frontend/dist/rtf-frontend/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
