{
  "name": "rtf-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup:https": "node -e \"require('node:fs').mkdirSync('certs', { recursive: true })\" && mkcert -install && mkcert -cert-file certs/localhost.pem -key-file certs/localhost-key.pem localhost 127.0.0.1 ::1",
    "start": "ng serve --host localhost --ssl --ssl-cert certs/localhost.pem --ssl-key certs/localhost-key.pem",
    "build": "ng build"
  },
  "dependencies": {
    "@angular-devkit/build-angular": "^19.2.14",
    "@angular/animations": "^19.2.14",
    "@angular/cdk": "^19.2.14",
    "@angular/cli": "^19.2.14",
    "@angular/common": "^19.2.14",
    "@angular/compiler": "^19.2.14",
    "@angular/compiler-cli": "^19.2.14",
    "@angular/core": "^19.2.14",
    "@angular/forms": "^19.2.14",
    "@angular/material": "^19.2.14",
    "@angular/platform-browser": "^19.2.14",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "typescript": "~5.8.3",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {}
}
